/* before the root
   // not nested */
"R" /* after name */
{
    a 1 /* after value */
    /* a whole line
       b 2
       // c 3
    */
    d /*mid*/ 4
    "e" "x /* not a comment */ y"
    f 5/*x*/
    path hl2/custom/*
    /**/ l 10
    g 6//line /* still a line comment
    h 7 /* ** / * /*/ i 8
    sub /* x */ { /* y */ j 9 /* z */ }
    k "a//b"
}
/* after the root */
